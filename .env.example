# Required
API_ID=12345678
API_HASH=replace_with_your_api_hash
BOT_TOKEN=replace_with_your_bot_token
DATABASE_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
ADMINS=123456789
LOG_CHANNEL=-1001234567890

# Database and indexing
DATABASE_NAME=FilmXBot
COLLECTION_NAME=Telegram_files
CHANNELS=-1001234567890
FILE_STORE_CHANNEL=

# Force subscribe (optional)
AUTH_CHANNEL=
# REQUIRED_CHANNEL_ID takes precedence over AUTH_CHANNEL when set.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=
REQ_CHANNEL=
JOIN_REQS_DB=
PENDING_REQUEST_TTL_HOURS=24

# Telegram Mini App (set this to the public HTTPS URL of this deployment)
MINI_APP_URL=
MINI_APP_NAME=FilmX
WEB_SERVER_ENABLED=True
WEB_SERVER_PORT=8080
MINI_APP_AUTH_MAX_AGE=86400

# Behavior (optional)
USE_CAPTION_FILTER=False
PROTECT_CONTENT=False
PUBLIC_FILE_STORE=True
CACHE_TIME=300
